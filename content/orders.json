{
  "$schema": "https://json.swell.store/content.json",
  "collection": "orders",
  "description": "Sendcloud parcel details on orders",
  "fields": [
    {
      "id": "sendcloud_order_id",
      "label": "Sendcloud order ID",
      "type": "number",
      "readonly": true
    },
    {
      "id": "sendcloud_parcel_id",
      "label": "Parcel ID",
      "type": "number",
      "readonly": true
    },
    {
      "id": "sendcloud_status",
      "label": "Status",
      "type": "short_text",
      "readonly": true
    },
    {
      "id": "sendcloud_tracking_number",
      "label": "Tracking number",
      "type": "short_text",
      "readonly": true
    },
    {
      "id": "sendcloud_tracking_url",
      "label": "Tracking page",
      "type": "short_text",
      "readonly": true
    },
    {
      "id": "sendcloud_carrier",
      "label": "Carrier",
      "type": "short_text",
      "readonly": true
    },
    {
      "id": "sendcloud_error",
      "label": "Error",
      "type": "long_text",
      "readonly": true
    },
    {
      "id": "sendcloud_invoice_id",
      "label": "Invoice",
      "type": "short_text",
      "readonly": true
    }
  ],
  "views": [
    {
      "id": "list",
      "fields": [
        {
          "id": "sendcloud_status",
          "label": "Sendcloud"
        }
      ],
      "bulk_actions": [
        {
          "id": "check_and_send",
          "label": "Check and send to Sendcloud",
          "function": "check-and-send",
          "loading_label": "Checking orders…",
          "hint": "Up to 10 orders. Uses the same rules as a paid order: skips test and canceled orders, holds a separate order schedule until the invoice is paid and nothing is overdue, and sends the order when it may go. A held order keeps that status, so a later paid invoice sends it."
        },
        {
          "id": "send_to_sendcloud",
          "label": "Send to Sendcloud",
          "function": "send-to-sendcloud",
          "loading_label": "Sending to Sendcloud…",
          "hint": "Sends up to 10 selected orders. Waiting and test orders are sent too. Unpaid and canceled orders are skipped. An order already in Sendcloud is updated, unless it has a label."
        }
      ]
    },
    {
      "id": "edit",
      "extra_actions": [
        {
          "id": "check_and_send",
          "label": "Check and send to Sendcloud",
          "function": "check-and-send",
          "loading_label": "Checking this order…",
          "hint": "Uses the same rules as a paid order. Skips a test or canceled order. Holds a separate order schedule until the invoice is paid and nothing is overdue, and stores that status so a later paid invoice sends the order. Sends the order when it may go."
        },
        {
          "id": "send_to_sendcloud",
          "label": "Send to Sendcloud",
          "function": "send-to-sendcloud",
          "loading_label": "Sending to Sendcloud…",
          "hint": "Sends this order, or updates it in Sendcloud when it is already there and has no label. Unpaid and canceled orders are skipped. Waiting and test orders are sent too."
        }
      ],
      "tabs": [
        {
          "id": "sendcloud",
          "label": "Sendcloud",
          "fields": [
            {
              "type": "field_row",
              "fields": [
                {
                  "id": "sendcloud_order_id",
                  "admin_span": 2
                },
                {
                  "id": "sendcloud_status",
                  "admin_span": 2
                }
              ]
            },
            {
              "type": "field_row",
              "fields": [
                {
                  "id": "sendcloud_parcel_id",
                  "admin_span": 2
                },
                {
                  "id": "sendcloud_carrier",
                  "admin_span": 2
                }
              ]
            },
            {
              "type": "field_row",
              "fields": [
                {
                  "id": "sendcloud_tracking_number",
                  "admin_span": 4
                }
              ]
            },
            {
              "id": "sendcloud_tracking_url"
            },
            {
              "id": "sendcloud_invoice_id"
            },
            {
              "id": "sendcloud_error",
              "conditions": {
                "sendcloud_error": {
                  "$exists": true
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
